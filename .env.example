# ResonanceX local configuration (copy to .env). All values are optional.
# Where uploads, analyses and the SQLite database are stored (default: ./data)
# RESONANCEX_DATA_DIR=./data
# RESONANCEX_MAX_UPLOAD_MB=300
# RESONANCEX_MAX_DURATION_SECONDS=1800
# Number of parallel analysis worker threads (1 keeps a laptop responsive)
# RESONANCEX_ANALYSIS_WORKERS=1
# The API binds to localhost only by default. Do not expose it publicly.
# RESONANCEX_HOST=127.0.0.1
# RESONANCEX_PORT=8000
#
# --- Provider integrations (optional) ---------------------------------------
# ElevenLabs Music API key. Read only by the local server – never sent to the
# browser. Nothing is sent to ElevenLabs until you confirm a request in the app.
# ELEVENLABS_API_KEY=
# Price used for cost estimates (USD per generated minute) – check elevenlabs.io/pricing/api
# RESONANCEX_ELEVENLABS_USD_PER_MINUTE=0.15
# Requests estimated above this amount are refused.
# RESONANCEX_MAX_GENERATION_USD=3.0
# RESONANCEX_GENERATION_TIMEOUT_SECONDS=600
#
# Suno needs no key here: use the manual workflow, or the official Suno MCP server
# from Claude Code (see docs/PROVIDER_INTEGRATIONS.md).
