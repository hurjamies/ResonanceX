# ResonanceX local configuration (copy to .env). All values are optional.
# Where uploads, analyses and the SQLite database are stored (default: ./data)
# RESONANCEX_DATA_DIR=./data
# RESONANCEX_MAX_UPLOAD_MB=300
# RESONANCEX_MAX_DURATION_SECONDS=1800
# Number of parallel analysis worker threads (1 keeps a laptop responsive)
# RESONANCEX_ANALYSIS_WORKERS=1
# The API binds to localhost only by default. Do not expose it publicly.
# RESONANCEX_HOST=127.0.0.1
# RESONANCEX_PORT=8000
#
# No external AI provider keys are used in this version.
# Future provider secrets must stay server-side and must never be committed.
